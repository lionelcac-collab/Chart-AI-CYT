{
  "expo": {
    "name": "Chart-BoursafrikIA",
    "slug": "chart-boursafrikia",
    "scheme": "chart-boursafrikia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#161B1E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chartboursafrikia.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Chart-BoursafrikIA accède à vos photos uniquement pour analyser la capture d'écran de graphique que vous choisissez.",
        "NSCameraUsageDescription": "Chart-BoursafrikIA utilise l'appareil photo uniquement si vous photographiez un graphique à analyser."
      }
    },
    "android": {
      "package": "com.chartboursafrikia.app",
      "adaptiveIcon": {
        "backgroundColor": "#161B1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#6EECF2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chart-BoursafrikIA accède à vos photos uniquement pour analyser la capture d'écran de graphique que vous choisissez."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}