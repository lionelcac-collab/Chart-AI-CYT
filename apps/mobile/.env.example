# Supabase (Settings → API). Without these, the app runs in clearly-labelled DEMO mode (fictional data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Force demo mode (screenshots / development only)
EXPO_PUBLIC_DEMO=0
